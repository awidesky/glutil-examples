#ifndef CONFIG_HPP_IN
#define CONFIG_HPP_IN

#include <filesystem>

namespace glutil { std::filesystem::path getExecutableDirectory(); }

inline const std::filesystem::path PROJECT_ROOT = R"(@CMAKE_SOURCE_DIR@)";
inline const std::filesystem::path ASSET_ROOT   = R"(@ASSET_DIR@)";

inline std::filesystem::path project_root = PROJECT_ROOT;
inline std::filesystem::path asset_root = ASSET_ROOT;

inline void checkPath() {
    if (!std::filesystem::is_directory(asset_root)) {
        std::filesystem::path basepath = std::filesystem::current_path();
        if (!std::filesystem::is_directory(basepath / "assets")) basepath = glutil::getExecutableDirectory();
        project_root = basepath;
        asset_root = basepath / "assets";
    }
}

#endif // CONFIG_HPP_IN